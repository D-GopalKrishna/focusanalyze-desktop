{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FocusAnalyze",
  "version": "0.1.0",
  "identifier": "com.focusanalyze.desktop",
  "build": {
    "frontendDist": "../../focusanalyze-fe/out",
    "devUrl": "http://localhost:3000/desktop-auth",
    "beforeDevCommand": "node scripts/start-fe-dev.js",
    "beforeBuildCommand": "node scripts/build-fe.js"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQjJENUUyQjY0OUNGRjQKUldUMHowbTI0dFd5bWd3VTN3eitjc1c1bTR4YzVuRisySUROWkljR0llemFNSzZwVEdpblJveWYK",
      "endpoints": [
        "https://github.com/D-GopalKrishna/focusanalyze-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
