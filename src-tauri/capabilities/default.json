{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:9843/*",
      "http://localhost:9844/*",
      "http://localhost:9845/*",
      "http://localhost:9846/*",
      "http://localhost:9847/*"
    ]
  },
  "permissions": [
    "core:default",
    "process:default",
    "opener:default",
    "allow-begin-oauth-callback-listener",
    "allow-cancel-oauth-callback-listener",
    "allow-clear-auth-tokens",
    "allow-exchange-oauth-code",
    "allow-export-processes-to-csv",
    "allow-get-active-window-title",
    "allow-get-processes",
    "allow-load-auth-tokens",
    "allow-refresh-oauth-tokens",
    "allow-save-auth-tokens",
    "allow-wait-oauth-callback"
  ]
}